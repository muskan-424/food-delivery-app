# Staging environment template (copy to .env.staging and load before compose)
# PowerShell: Get-Content .env.staging | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
# Bash: set -a && source .env.staging && set +a

JWT_SECRET=staging-replace-with-long-random-string
JWT_REFRESH_SECRET=staging-replace-with-long-random-refresh
MONGO_URL=mongodb://admin:password@localhost:27017/food-delivery?authSource=admin

# Lock CORS to your staging origins, comma-separated
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com,http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Demo-friendly defaults (enable real keys when ready)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYOUT_ACCOUNT_NUMBER=
GEMINI_API_KEY=

# Wave 1 marketplace flags
ENABLE_ESCROW_PAYMENTS=true
ENABLE_USER_KYC=true
KYC_REQUIRED_FOR_PAYOUT=true
KYC_STUB_AUTO_VERIFY=true
ENABLE_EMAIL_OTP=true
ENABLE_AI_AGENT=true
USE_MOCK_AGENT=true
ENABLE_ORDER_CHAT=true
ENABLE_ORDER_REQUEST_DRAFTS=true
ENABLE_VOICE_ASSIST=true
